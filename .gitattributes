# Auto detect text files and perform LF normalization
* text=auto

# Code files
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.parquet binary
*.orc binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
